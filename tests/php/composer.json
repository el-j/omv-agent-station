{
    "name": "el-j/omv-agent-station-php-tests",
    "description": "PHPUnit harness for openmediavault-agent-station's engined/rpc/agentstation.inc",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse -c phpstan.neon --no-progress",
        "check": [
            "@analyse",
            "@test"
        ]
    }
}
