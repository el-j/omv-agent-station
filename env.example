# ==============================================================================
# OpenMediaVault AI Orchestrator Stack Configuration
# Optimized for your Pro Subscriptions:
# 1. Google AI Pro (Gemini 3.7 Flash & Pro via Google AI Studio)
# 2. Claude Pro (Claude 3.7 Sonnet via Anthropic Console / Claude Code)
# 3. GitHub Copilot Pro (GPT-4o & o3-mini via GitHub Models)
# ==============================================================================

# Server Data Path on OMV (e.g. /srv/dev-data or /export/data)
DATA_DIR=/srv/dev-data
TZ=Europe/Berlin

# Security Master Key for your LiteLLM Proxy Gateway
LITELLM_MASTER_KEY=sk-omv-secret-master-key-change-me

# ------------------------------------------------------------------------------
# 1. Google AI Pro -> Google AI Studio Key (Gemini 3.7 Flash & Pro)
# Generate your key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 2. Claude Pro -> Anthropic API Key (Claude 3.7 Sonnet Thinking)
# Generate your key at: https://console.anthropic.com/
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# ------------------------------------------------------------------------------
# 3. GitHub Copilot Pro -> GitHub Personal Access Token (GPT-4o & o3-mini)
# Generate PAT at: https://github.com/settings/tokens (select 'repo' or 'models')
# ------------------------------------------------------------------------------
GITHUB_TOKEN=ghp_...

# ------------------------------------------------------------------------------
# 4. Optional: Google Cloud Vertex AI (if using GCP project credits)
# ------------------------------------------------------------------------------
VERTEX_PROJECT_ID=
VERTEX_LOCATION=europe-west1
VERTEX_CREDENTIALS_PATH=

# ------------------------------------------------------------------------------
# 5. Git Provider Integration & Committer Identity
# Used by the agents to clone, commit, and push branches to remote repositories
# ------------------------------------------------------------------------------
GIT_AUTHOR_NAME=OMV AI Agent
GIT_AUTHOR_EMAIL=agent@proliant-omv.local

# Optional additional Git providers (GitHub token is configured in section 3 above)
GITLAB_TOKEN=glpat-...
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Chat Relay Options: Telegram Bot OR Signal Messenger
# ------------------------------------------------------------------------------
# Option A: Telegram Bot (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_ALLOWED_USER_ID=123456789

# Option B: Signal Messenger (End-to-End Encrypted Private Bot)
# Requires running with --profile signal
SIGNAL_PHONE_NUMBER=+4915112345678
SIGNAL_ALLOWED_PHONE_NUMBER=+4917098765432

# Web Terminal Credentials (ttyd)
TERMINAL_USER=admin
TERMINAL_PASS=proliantgen8secure
