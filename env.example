# ==============================================================================
# OpenMediaVault AI Orchestrator Stack Configuration
# Copy this file to .env and fill in your keys
# ==============================================================================

# Server Data Path on OMV (e.g. /srv/dev-data or /export/data)
DATA_DIR=/srv/dev-data
TZ=Europe/Berlin

# Security & Master Key for LiteLLM
LITELLM_MASTER_KEY=sk-omv-secret-master-key-change-me

# ------------------------------------------------------------------------------
# 1. Google AI (Gemini Studio API Key)
# Get yours free/paid at https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 2. Claude Code / Anthropic API Key
# Get yours at https://console.anthropic.com/
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# ------------------------------------------------------------------------------
# 3. Microsoft Copilot / GitHub Token
# Create a GitHub PAT at https://github.com/settings/tokens (with 'repo' or 'models' access)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=ghp_...

# Optional Universal Fallback APIs
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# 4. Telegram Bot Configuration
# Create bot via @BotFather and get token
# Get your numeric User ID via @userinfobot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_ALLOWED_USER_ID=123456789

# Web Terminal Credentials
TERMINAL_USER=admin
TERMINAL_PASS=proliantgen8secure
