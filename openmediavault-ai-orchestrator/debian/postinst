#!/bin/sh
set -e

case "$1" in
    configure)
        # Populate OMV datamodels and workbench cache
        if [ -x /usr/sbin/omv-engined ]; then
            omv-engined -f -u || true
        fi
        if [ -x /usr/sbin/omv-rpc ]; then
            omv-rpc -u admin "AIOrchestrator" "syncConfig" "{}" 2>/dev/null || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
