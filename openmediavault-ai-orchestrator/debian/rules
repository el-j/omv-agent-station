#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_install:
	mkdir -p debian/openmediavault-ai-orchestrator/usr/share/openmediavault/engined/rpc
	mkdir -p debian/openmediavault-ai-orchestrator/usr/share/openmediavault/datamodels
	mkdir -p debian/openmediavault-ai-orchestrator/usr/share/openmediavault/workbench/component.d
	mkdir -p debian/openmediavault-ai-orchestrator/usr/share/openmediavault/workbench/navigation.d
	mkdir -p debian/openmediavault-ai-orchestrator/usr/share/openmediavault/ai-orchestrator
	mkdir -p debian/openmediavault-ai-orchestrator/usr/sbin
	mkdir -p debian/openmediavault-ai-orchestrator/etc/systemd/system

	cp -r usr/share/openmediavault/engined/rpc/* debian/openmediavault-ai-orchestrator/usr/share/openmediavault/engined/rpc/ 2>/dev/null || true
	cp -r usr/share/openmediavault/datamodels/* debian/openmediavault-ai-orchestrator/usr/share/openmediavault/datamodels/ 2>/dev/null || true
	cp -r usr/share/openmediavault/workbench/component.d/* debian/openmediavault-ai-orchestrator/usr/share/openmediavault/workbench/component.d/ 2>/dev/null || true
	cp -r usr/share/openmediavault/workbench/navigation.d/* debian/openmediavault-ai-orchestrator/usr/share/openmediavault/workbench/navigation.d/ 2>/dev/null || true
	cp usr/sbin/omv-ai-orchestrator debian/openmediavault-ai-orchestrator/usr/sbin/
	chmod +x debian/openmediavault-ai-orchestrator/usr/sbin/omv-ai-orchestrator

	cp -r ../docker-compose.yml ../litellm ../telegram-agent-bot debian/openmediavault-ai-orchestrator/usr/share/openmediavault/ai-orchestrator/
