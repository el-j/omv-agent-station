{
  "type": "config",
  "id": "conf.service.aiorchestrator",
  "title": "AI Orchestrator",
  "query": "//services/aiorchestrator",
  "properties": {
    "enable": {
      "type": "boolean",
      "default": false
    },
    "data_dir": {
      "type": "string",
      "default": "/srv/dev-data"
    },
    "gemini_api_key": {
      "type": "string"
    },
    "anthropic_api_key": {
      "type": "string"
    },
    "github_token": {
      "type": "string"
    },
    "git_author_name": {
      "type": "string",
      "default": "OMV AI Agent"
    },
    "git_author_email": {
      "type": "string",
      "default": "agent@omv-box.local"
    },
    "gitlab_token": {
      "type": "string"
    },
    "bitbucket_username": {
      "type": "string"
    },
    "bitbucket_app_password": {
      "type": "string"
    },
    "chat_service": {
      "type": "string",
      "default": "telegram"
    },
    "telegram_bot_token": {
      "type": "string"
    },
    "telegram_allowed_user_id": {
      "type": "string"
    },
    "signal_phone_number": {
      "type": "string"
    },
    "signal_allowed_phone_number": {
      "type": "string"
    },
    "discord_bot_token": {
      "type": "string"
    },
    "discord_allowed_user_id": {
      "type": "string"
    },
    "litellm_master_key": {
      "type": "string",
      "default": "sk-omv-master-key"
    },
    "terminal_user": {
      "type": "string",
      "default": "admin"
    },
    "terminal_pass": {
      "type": "string",
      "default": "omvsecurepass"
    }
  }
}
