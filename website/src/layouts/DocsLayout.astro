---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  category?: string;
  prevPage?: { title: string; href: string };
  nextPage?: { title: string; href: string };
}

const { 
  title, 
  description = "OMV AI Agent Station Technical Documentation & Architecture Reference", 
  category = "Documentation",
  prevPage,
  nextPage
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '');

const docSections = [
  {
    group: "🚀 Getting Started",
    links: [
      { title: "Architecture & Overview", href: `${baseUrl}/docs`, icon: "🏛️" },
      { title: "Quickstart & Installation", href: `${baseUrl}/docs/quickstart`, icon: "⚡" },
      { title: "Standalone / Raspberry Pi Install", href: `${baseUrl}/docs/standalone-install`, icon: "🐧" },
    ]
  },
  {
    group: "🧠 AI Intelligence & Gateway",
    links: [
      { title: "AI Models & Multi-Tier Routing", href: `${baseUrl}/docs/ai-models`, icon: "🧠" },
    ]
  },
  {
    group: "💬 Messenger Bots",
    links: [
      { title: "Telegram Bot (27 Commands)", href: `${baseUrl}/docs/telegram`, icon: "✈️" },
      { title: "Discord & Signal Relays", href: `${baseUrl}/docs/discord-signal`, icon: "📡" },
    ]
  },
  {
    group: "⚡ Customization",
    links: [
      { title: "Custom Commands & Aliases", href: `${baseUrl}/docs/custom-commands`, icon: "⚡" },
    ]
  },
  {
    group: "📂 Workspace & Notes",
    links: [
      { title: "Git Workspaces & Auto-Cloning", href: `${baseUrl}/docs/git-workspaces`, icon: "📂" },
      { title: "Obsidian & Syncthing Sync", href: `${baseUrl}/docs/obsidian-sync`, icon: "📓" },
    ]
  },
  {
    group: "🛡️ Security & Ops",
    links: [
      { title: "Security & Credential Vault", href: `${baseUrl}/docs/security`, icon: "🛡️" },
      { title: "Diagnostics & Telemetry", href: `${baseUrl}/docs/diagnostics`, icon: "📊" },
    ]
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📚</text></svg>" />
    <title>{title} — OMV AI Agent Station Docs</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070a12" />
    <!-- Analytics -->
    <script defer src="https://umami-phi-six-29.vercel.app/script.js" data-website-id="86dcde09-662c-4647-ae6f-f15c7cfa7e05"></script>
  </head>
  <body>
    <!-- Top Global Sticky Navbar -->
    <nav style="position: sticky; top: 0; z-index: 50; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); background: rgba(7, 10, 18, 0.9); border-bottom: 1px solid var(--border-color); padding: 0.75rem 0;">
      <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
        <!-- Logo -->
        <a href={`${baseUrl}/`} style="text-decoration: none; display: flex; align-items: center; gap: 0.75rem;">
          <div style="width: 36px; height: 36px; border-radius: 8px; background: linear-gradient(135deg, #6366f1, #06b6d4); display: flex; align-items: center; justify-content: center; font-size: 1.15rem; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35);">
            🤖
          </div>
          <span style="font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 1.15rem; color: #fff; letter-spacing: -0.02em;">
            OMV <span class="gradient-text">Agent Station</span> <span style="font-size: 0.75rem; background: rgba(99, 102, 241, 0.2); color: #a5b4fc; padding: 0.15rem 0.5rem; border-radius: 4px; border: 1px solid rgba(99, 102, 241, 0.3); font-weight: 600; margin-left: 0.25rem;">DOCS</span>
          </span>
        </a>

        <!-- Top Right Links -->
        <div style="display: flex; align-items: center; gap: 1rem;">
          <a href={`${baseUrl}/`} style="color: var(--text-muted); text-decoration: none; font-size: 0.88rem; font-weight: 500; transition: color 0.2s;">
            🏠 Home
          </a>
          <a href="https://github.com/el-j/omv-agent-station" target="_blank" class="btn btn-secondary" style="padding: 0.4rem 0.85rem; font-size: 0.82rem; border-radius: 0.4rem; display: flex; align-items: center; gap: 0.4rem;">
            ⭐ GitHub
          </a>
        </div>
      </div>
    </nav>

    <!-- Main Docs Container with Sticky Sidebar -->
    <div class="container" style="max-width: 1300px; padding: 2rem 1.5rem; min-height: 85vh;">
      <div class="docs-wrapper" style="display: grid; grid-template-columns: 280px 1fr; gap: 2.5rem; align-items: start;">
        
        <!-- Sidebar Navigation -->
        <aside class="docs-sidebar" style="position: sticky; top: 5.5rem; background: rgba(14, 20, 36, 0.85); border: 1px solid var(--border-color); border-radius: 1rem; padding: 1.5rem; backdrop-filter: blur(12px); max-height: calc(100vh - 7rem); overflow-y: auto;">
          <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-secondary); font-weight: 700; margin-bottom: 1.25rem;">
            📖 Documentation
          </div>
          
          <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            {docSections.map(sec => (
              <div>
                <div style="font-size: 0.82rem; font-weight: 700; color: #e2e8f0; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem;">
                  {sec.group}
                </div>
                <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.25rem; padding-left: 0.5rem; border-left: 1px solid rgba(255,255,255,0.06);">
                  {sec.links.map(link => {
                    const isActive = currentPath === link.href.replace(/\/$/, '') || (link.href === `${baseUrl}/docs` && (currentPath === `${baseUrl}/docs` || currentPath === `${baseUrl}/docs/`));
                    return (
                      <li>
                        <a 
                          href={link.href} 
                          style={`display: flex; align-items: center; gap: 0.5rem; padding: 0.45rem 0.65rem; border-radius: 0.4rem; font-size: 0.84rem; text-decoration: none; transition: all 0.2s; ${isActive ? 'background: rgba(99, 102, 241, 0.2); color: #fff; font-weight: 600; border-left: 2px solid var(--accent-primary);' : 'color: var(--text-muted);'}`}
                        >
                          <span>{link.icon}</span>
                          <span>{link.title}</span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </div>
        </aside>

        <!-- Main Content Area -->
        <main class="docs-content" style="min-width: 0;">
          <!-- Breadcrumb -->
          <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; color: var(--text-muted); margin-bottom: 1rem;">
            <a href={`${baseUrl}/docs`} style="color: var(--text-muted); text-decoration: none;">Docs</a>
            <span>/</span>
            <span style="color: #cbd5e1;">{category}</span>
            <span>/</span>
            <span style="color: var(--accent-secondary); font-weight: 600;">{title}</span>
          </div>

          <!-- Page Header -->
          <header style="margin-bottom: 2.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem;">
            <h1 style="font-family: 'Outfit', sans-serif; font-size: 2.4rem; font-weight: 800; color: #fff; margin-bottom: 0.75rem; letter-spacing: -0.02em;">
              {title}
            </h1>
            <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.6;">
              {description}
            </p>
          </header>

          <!-- Injected Markdown / HTML Content -->
          <article class="docs-body">
            <slot />
          </article>

          <!-- Bottom Previous / Next Navigation Cards -->
          {(prevPage || nextPage) && (
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border-color);">
              {prevPage ? (
                <a href={prevPage.href} class="glass-card" style="text-decoration: none; padding: 1.25rem; border-radius: 0.75rem;">
                  <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.35rem;">← Previous</div>
                  <div style="color: #fff; font-weight: 600; font-size: 0.95rem;">{prevPage.title}</div>
                </a>
              ) : <div />}
              
              {nextPage && (
                <a href={nextPage.href} class="glass-card" style="text-decoration: none; padding: 1.25rem; border-radius: 0.75rem; text-align: right;">
                  <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.35rem;">Next →</div>
                  <div style="color: var(--accent-secondary); font-weight: 600; font-size: 0.95rem;">{nextPage.title}</div>
                </a>
              )}
            </div>
          )}
        </main>
      </div>
    </div>

    <!-- Global Docs Body Styles -->
    <style is:global>
      .docs-body h2 {
        font-family: 'Outfit', sans-serif;
        font-size: 1.6rem;
        font-weight: 700;
        color: #f8fafc;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.06);
      }
      .docs-body h3 {
        font-family: 'Outfit', sans-serif;
        font-size: 1.25rem;
        font-weight: 600;
        color: #e2e8f0;
        margin-top: 1.75rem;
        margin-bottom: 0.75rem;
      }
      .docs-body p {
        color: #cbd5e1;
        font-size: 0.96rem;
        line-height: 1.7;
        margin-bottom: 1.25rem;
      }
      .docs-body ul, .docs-body ol {
        margin-bottom: 1.25rem;
        padding-left: 1.5rem;
        color: #cbd5e1;
        font-size: 0.96rem;
        line-height: 1.7;
      }
      .docs-body li {
        margin-bottom: 0.35rem;
      }
      .docs-body code {
        background: rgba(15, 23, 42, 0.85);
        color: #38bdf8;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        font-size: 0.88em;
        border: 1px solid rgba(255,255,255,0.08);
      }
      .docs-body pre {
        background: #090d16;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 0.75rem;
        padding: 1.25rem;
        overflow-x: auto;
        margin: 1.25rem 0;
        position: relative;
      }
      .docs-body pre code {
        background: transparent;
        color: #e2e8f0;
        padding: 0;
        border: none;
        font-size: 0.88rem;
        line-height: 1.6;
      }
      .docs-callout {
        background: rgba(14, 20, 36, 0.75);
        border-left: 4px solid var(--accent-primary);
        border-radius: 0 0.75rem 0.75rem 0;
        padding: 1.25rem 1.5rem;
        margin: 1.5rem 0;
      }
      .docs-callout-info { border-left-color: var(--accent-secondary); }
      .docs-callout-success { border-left-color: var(--accent-emerald); }
      .docs-callout-warning { border-left-color: var(--accent-amber); }
      
      .docs-table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.9rem;
      }
      .docs-table th {
        background: rgba(15, 23, 42, 0.95);
        color: #fff;
        text-align: left;
        padding: 0.75rem 1rem;
        border-bottom: 2px solid rgba(255,255,255,0.1);
      }
      .docs-table td {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        color: #cbd5e1;
      }
      .docs-table tr:hover td {
        background: rgba(255,255,255,0.02);
      }

      @media (max-width: 900px) {
        .docs-wrapper {
          grid-template-columns: 1fr !important;
        }
        .docs-sidebar {
          position: static !important;
          max-height: none !important;
          margin-bottom: 2rem;
        }
      }
    </style>
  </body>
</html>
