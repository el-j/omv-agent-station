---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Documentation & Complete Handbook | OMV Agent Station" description="Comprehensive handbook, command reference, Obsidian sync guide, Telegram Forum Topics architecture, and LiteLLM AI Gateway documentation for OpenMediaVault Agent Station.">
  <div class="container" style="padding: 3rem 0 5rem 0;">
    <!-- Breadcrumb / Header -->
    <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
      <a href={`${base}/`} style="color: var(--text-muted); text-decoration: none;">Home</a>
      <span>›</span>
      <span style="color: #c7d2fe; font-weight: 600;">Documentation & Handbook</span>
    </div>

    <!-- Docs Hero -->
    <div style="margin-bottom: 3.5rem;">
      <h1 style="font-family: 'Outfit', sans-serif; font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 900; line-height: 1.15; margin-bottom: 1rem; letter-spacing: -0.02em;">
        Agent Station <span class="gradient-text">Complete Handbook & Docs</span>
      </h1>
      <p style="font-size: 1.15rem; color: var(--text-muted); max-width: 850px; line-height: 1.6;">
        Everything you need to turn your OpenMediaVault server into an autonomous, 24/7 self-healing AI development station with Telegram Forum Topics, Obsidian Second Brain sync, and multi-provider LLM failover.
      </p>
    </div>

    <!-- Documentation Main Grid -->
    <div style="display: grid; grid-template-columns: 260px 1fr; gap: 2.5rem; align-items: start;" class="docs-layout">
      <!-- Sticky Sidebar Navigation -->
      <aside style="position: sticky; top: 5.5rem; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 1rem; padding: 1.5rem; backdrop-filter: blur(12px);">
        <div style="font-family: 'Outfit'; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: #818cf8; font-weight: 800; margin-bottom: 1rem;">
          Documentation Index
        </div>
        <nav style="display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.9rem;">
          <a href="#quickstart" class="doc-nav-link">⚡ Quick Start Guide</a>
          <a href="#custom-commands" class="doc-nav-link">🛠️ Custom Commands & Aliases</a>
          <a href="#obsidian-sync" class="doc-nav-link">📓 Obsidian Second Brain</a>
          <a href="#telegram-topics" class="doc-nav-link">🧵 Telegram Forum Topics</a>
          <a href="#commands" class="doc-nav-link">🤖 Bot Commands Reference</a>
          <a href="#newrepo-guide" class="doc-nav-link">🐙 GitHub Repo Creation</a>
          <a href="#litellm-gateway" class="doc-nav-link">🧠 LiteLLM AI Gateway</a>
          <a href="#web-terminal" class="doc-nav-link">🖥️ Sandboxed Web Terminal</a>
          <a href="#security-model" class="doc-nav-link">🛡️ Security & Zero-Trust</a>
          <a href="#troubleshooting" class="doc-nav-link">🔍 Diagnostics & Debugging</a>
        </nav>
      </aside>

      <!-- Docs Content Stream -->
      <div style="display: flex; flex-direction: column; gap: 3.5rem;">

        <!-- ================================================================= -->
        <!-- 1. QUICK START                                                    -->
        <!-- ================================================================= -->
        <section id="quickstart" class="glass-card" style="padding: 2.25rem;">
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(99, 102, 241, 0.15); color: #818cf8; font-size: 0.85rem; font-weight: 700; padding: 0.3rem 0.8rem; border-radius: 9999px; margin-bottom: 1rem;">
            Step-by-Step
          </div>
          <h2 style="font-family: 'Outfit'; font-size: 1.85rem; font-weight: 800; margin-bottom: 1rem;">
            ⚡ Quick Start: 3-Minute Deployment
          </h2>
          <p style="color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.6;">
            The Agent Station plugin integrates directly into OpenMediaVault 6, 7 & 8 as a native Debian package.
          </p>

          <div style="margin-bottom: 1.5rem;">
            <h4 style="font-weight: 700; margin-bottom: 0.5rem; color: #e2e8f0;">1. Install the Plugin on your OMV Server</h4>
            <div class="terminal-snippet" style="margin-bottom: 0.75rem;">
              <span style="color: #6366f1; font-weight: 700;">$</span>
              <span class="terminal-text">wget -qO- https://raw.githubusercontent.com/el-j/omv-agent-station/main/scripts/install-plugin.sh | sudo bash</span>
            </div>
          </div>

          <div style="margin-bottom: 1.5rem;">
            <h4 style="font-weight: 700; margin-bottom: 0.5rem; color: #e2e8f0;">2. Open the OMV WebGUI</h4>
            <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 0.5rem;">
              Navigate to <strong>Services ➔ Agent Station ➔ Overview</strong>, check <strong>Enable Agent Station Engine</strong>, and click <strong>Save</strong>.
            </p>
          </div>

          <div>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem; color: #e2e8f0;">3. Add Your AI API Keys</h4>
            <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.5;">
              Go to <strong>AI Models</strong> to add your free Google AI Studio key, GitHub Copilot token, or Claude key. The stack will instantly boot LiteLLM, Syncthing, Web Terminal, and your Messenger Relays.
            </p>
          </div>
        </section>

        <!-- ================================================================= -->
        <!-- 2. CUSTOM BOT COMMANDS & SHORTCUT ALIASES                         -->
        <!-- ================================================================= -->
        <section id="custom-commands" class="glass-card" style="padding: 2.25rem;">
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(245, 158, 11, 0.15); color: #fbbf24; font-size: 0.85rem; font-weight: 700; padding: 0.3rem 0.8rem; border-radius: 9999px; margin-bottom: 1rem;">
            Custom Workflows
          </div>
          <h2 style="font-family: 'Outfit'; font-size: 1.85rem; font-weight: 800; margin-bottom: 1rem;">
            🛠️ Custom User-Defined Bot Commands & Aliases
          </h2>
          <p style="color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.6;">
            Configure and personalize your bot on the fly directly from chat. You can turn complex terminal commands, test suites, or repetitive AI prompt workflows into simple custom shortcuts.
          </p>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem;">
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 0.75rem; padding: 1.25rem;">
              <div style="font-weight: 700; color: #fbbf24; margin-bottom: 0.5rem;">⚡ Automated Test Runner</div>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.5rem;">Create a <code>/test</code> shortcut:</p>
              <code style="font-size: 0.85rem; color: #818cf8; display: block; margin-bottom: 0.5rem;">/addcmd test /exec pytest -v</code>
              <span style="font-size: 0.8rem; color: #94a3b8;">Now running <code>/test</code> instantly executes your pytest suite!</span>
            </div>

            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 0.75rem; padding: 1.25rem;">
              <div style="font-weight: 700; color: #38bdf8; margin-bottom: 0.5rem;">🤖 AI Code Review Template</div>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.5rem;">Dynamic argument placeholder <code>&#123;args&#125;</code>:</p>
              <code style="font-size: 0.85rem; color: #818cf8; display: block; margin-bottom: 0.5rem;">/addcmd review /chat "Review this code: &#123;args&#125;"</code>
              <span style="font-size: 0.8rem; color: #94a3b8;">Running <code>/review def login()...</code> passes the snippet directly to Claude/Gemini.</span>
            </div>

            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 0.75rem; padding: 1.25rem;">
              <div style="font-weight: 700; color: #34d399; margin-bottom: 0.5rem;">🚀 1-Click PR Drafts</div>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.5rem;">Automate routine Git tasks:</p>
              <code style="font-size: 0.85rem; color: #818cf8; display: block; margin-bottom: 0.5rem;">/addcmd pr /task "Create PR draft & changelog"</code>
              <span style="font-size: 0.8rem; color: #94a3b8;">Autonomous coding agent runs branch tasks in background.</span>
            </div>
          </div>

          <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.75rem; color: #e2e8f0;">Command Management:</h3>
          <ul style="list-style-type: disc; margin-left: 1.5rem; color: var(--text-muted); line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">
            <li><code>/addcmd &lt;name&gt; &lt;template&gt;</code> (alias: <code>/alias</code>) — Register or update a custom shortcut.</li>
            <li><code>/customcmds</code> (alias: <code>/cmds</code>, <code>/aliases</code>) — View all registered shortcuts and templates.</li>
            <li><code>/delcmd &lt;name&gt;</code> (alias: <code>/removecmd</code>) — Delete a custom command.</li>
          </ul>

          <div style="background: rgba(99, 102, 241, 0.08); border: 1px solid rgba(99, 102, 241, 0.25); border-radius: 0.75rem; padding: 1.25rem;">
            <div style="font-weight: 700; color: #c7d2fe; margin-bottom: 0.25rem;">📓 Synced Directly to Obsidian:</div>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">
              All custom commands are mirrored to <code>/data/obsidian/Config/commands.json</code>. You can also view and edit your command mappings directly inside Obsidian on your Mac, PC, or mobile device!
            </p>
          </div>
        </section>

        <!-- ================================================================= -->
        <!-- 3. OBSIDIAN SECOND BRAIN                                          -->
        <!-- ================================================================= -->
        <section id="obsidian-sync" class="glass-card" style="padding: 2.25rem;">
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(16, 185, 129, 0.15); color: #34d399; font-size: 0.85rem; font-weight: 700; padding: 0.3rem 0.8rem; border-radius: 9999px; margin-bottom: 1rem;">
            Second Brain Sync
          </div>
          <h2 style="font-family: 'Outfit'; font-size: 1.85rem; font-weight: 800; margin-bottom: 1rem;">
            📓 Obsidian Second Brain Integration (Zero Cloud Fees)
          </h2>
          <p style="color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.6;">
            Obsidian is a local-first markdown note engine. You do <strong>not</strong> need a paid Obsidian Sync subscription ($8–$10/mo). The Agent Station includes <strong>Syncthing</strong> (Port 8384) to synchronize notes continuously, privately, and bi-directionally between your PC/Mac/Mobile and your server.
          </p>

          <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.5rem;">
            <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.75rem; color: #38bdf8;">🔄 How the AI Uses Your Obsidian Vault:</h3>
            <ul style="list-style-type: disc; margin-left: 1.5rem; color: var(--text-muted); line-height: 1.7; font-size: 0.95rem;">
              <li><strong>Context Loading during Tasks:</strong> When you trigger <code>/task &lt;project&gt; &lt;prompt&gt;</code>, the agent scans <code>/obsidian/Projects/&lt;project&gt;/</code> for architecture specs, ADRs (architecture decision records), and conventions before generating code.</li>
              <li><strong>Automatic Task Logging:</strong> After every agent run, a Markdown log entry with git diff stats and commit hashes is appended to <code>/obsidian/Projects/&lt;project&gt;/agent-log.md</code>.</li>
              <li><strong>Fast Inbox Memos:</strong> Use <code>/note Title | Content</code> in chat to instantly append ideas to your Obsidian Inbox.</li>
            </ul>
          </div>

          <h4 style="font-weight: 700; margin-bottom: 0.5rem; color: #e2e8f0;">3-Step Syncthing Pairing:</h4>
          <ol style="margin-left: 1.5rem; color: var(--text-muted); line-height: 1.8; font-size: 0.95rem;">
            <li>Install Syncthing on your laptop/phone from <a href="https://syncthing.net/" target="_blank" style="color: #818cf8;">syncthing.net</a> (macOS: <code>brew install --cask syncthing</code>).</li>
            <li>Open your OMV Syncthing WebGUI at <code style="color: #34d399;">http://&lt;your-omv-ip&gt;:8384</code> and click <strong>Add Remote Device</strong>.</li>
            <li>Share your local Obsidian Vault folder with the server folder mapped to <code>/data/obsidian</code>. That's it!</li>
          </ol>
        </section>

        <!-- ================================================================= -->
        <!-- 3. TELEGRAM FORUM TOPICS                                          -->
        <!-- ================================================================= -->
        <section id="telegram-topics" class="glass-card" style="padding: 2.25rem;">
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(56, 189, 248, 0.15); color: #38bdf8; font-size: 0.85rem; font-weight: 700; padding: 0.3rem 0.8rem; border-radius: 9999px; margin-bottom: 1rem;">
            Organized Chat Architecture
          </div>
          <h2 style="font-family: 'Outfit'; font-size: 1.85rem; font-weight: 800; margin-bottom: 1rem;">
            🧵 Telegram Forum Topics (Project-Scoped Sub-Channels)
          </h2>
          <p style="color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.6;">
            Instead of having all project tasks, code diffs, logs, and notes mixed into a single chaotic chat, Telegram allows turning a Supergroup into a <strong>Forum with Topics</strong>.
          </p>

          <div style="background: rgba(14, 20, 36, 0.8); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.5rem; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #cbd5e1; line-height: 1.6;">
📁 My AI Agent Station (Telegram Forum Group)<br>
&nbsp;├── 💬 #General &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; (System uptime, LiteLLM model routing, global chat)<br>
&nbsp;├── 🐍 #backend-api &nbsp; &nbsp; &nbsp; &nbsp; (Linked to FastAPI repository)<br>
&nbsp;├── ⚛️ #frontend-ui &nbsp; &nbsp; &nbsp; &nbsp; (Linked to Next.js / Astro web app)<br>
&nbsp;├── 📓 #obsidian-brain &nbsp; &nbsp; (Architecture specs, notes, second-brain inbox)<br>
&nbsp;└── 🚀 #deployment &nbsp; &nbsp; &nbsp; &nbsp; (Docker containers & OMV maintenance)
          </div>

          <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.75rem; color: #f8fafc;">Automatic Project Scoping:</h3>
          <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1rem;">
            Inside a bound sub-channel (e.g. <code>#backend-api</code>), the bot automatically remembers the project context. You no longer have to type the repository name for every command:
          </p>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
            <div style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 0.5rem; padding: 1rem;">
              <div style="font-weight: 700; color: #f87171; margin-bottom: 0.25rem;">❌ Old / Single Chat:</div>
              <code style="font-size: 0.85rem;">/task backend-api Add auth middleware</code><br>
              <code style="font-size: 0.85rem;">/diff backend-api</code><br>
              <code style="font-size: 0.85rem;">/push backend-api main</code>
            </div>
            <div style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 0.5rem; padding: 1rem;">
              <div style="font-weight: 700; color: #34d399; margin-bottom: 0.25rem;">✅ In #backend-api Topic:</div>
              <code style="font-size: 0.85rem;">/task Add auth middleware</code><br>
              <code style="font-size: 0.85rem;">/diff</code><br>
              <code style="font-size: 0.85rem;">/push</code>
            </div>
          </div>

          <h4 style="font-weight: 700; margin-bottom: 0.5rem; color: #e2e8f0;">How to Set Up Forum Topics:</h4>
          <ol style="margin-left: 1.5rem; color: var(--text-muted); line-height: 1.8; font-size: 0.95rem;">
            <li>Create a new Group in Telegram and invite your Bot as an <strong>Administrator</strong>.</li>
            <li>In Telegram Group Settings ➔ Toggle <strong>Topics (Forum mode)</strong> to ON.</li>
            <li>Create a Topic for your project (or run <code>/newrepo my-project</code> which creates the topic automatically!).</li>
            <li>Inside the topic, type <code>/bind my-project</code>. You're done!</li>
          </ol>
        </section>

        <!-- ================================================================= -->
        <!-- 4. BOT COMMANDS REFERENCE                                         -->
        <!-- ================================================================= -->
        <section id="commands" class="glass-card" style="padding: 2.25rem;">
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(139, 92, 246, 0.15); color: #a78bfa; font-size: 0.85rem; font-weight: 700; padding: 0.3rem 0.8rem; border-radius: 9999px; margin-bottom: 1rem;">
            Handbook
          </div>
          <h2 style="font-family: 'Outfit'; font-size: 1.85rem; font-weight: 800; margin-bottom: 1rem;">
            🤖 Complete Bot Command Reference
          </h2>
          <p style="color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.6;">
            All commands work identically across <strong>Telegram</strong>, <strong>Discord</strong>, and <strong>Signal</strong> relays.
          </p>

          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <!-- /task -->
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 1rem 1.25rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <code style="font-size: 1rem; color: #818cf8; font-weight: 700;">/task [project] &lt;instructions&gt;</code>
                <span style="font-size: 0.75rem; background: rgba(99, 102, 241, 0.2); color: #c7d2fe; padding: 0.2rem 0.5rem; border-radius: 4px;">Autonomous Agent</span>
              </div>
              <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5;">
                Checks out a fresh git branch <code>agent/task-&lt;timestamp&gt;</code>, pulls Obsidian specs, executes the coding agent (Aider with LiteLLM proxy), runs tests, commits, and pushes to remote.
              </p>
            </div>

            <!-- /newrepo -->
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 1rem 1.25rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <code style="font-size: 1rem; color: #38bdf8; font-weight: 700;">/newrepo &lt;name&gt; [description] [--public | --private]</code>
                <span style="font-size: 0.75rem; background: rgba(56, 189, 248, 0.2); color: #bae6fd; padding: 0.2rem 0.5rem; border-radius: 4px;">GitHub API</span>
              </div>
              <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5;">
                Creates a new repository on your GitHub account, clones it locally to <code>/srv/dev-data/workspace/&lt;name&gt;</code>, creates README + .gitignore, commits, and auto-creates a Telegram Forum Topic.
              </p>
            </div>

            <!-- /bind -->
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 1rem 1.25rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <code style="font-size: 1rem; color: #34d399; font-weight: 700;">/bind [project-name]</code>
                <span style="font-size: 0.75rem; background: rgba(16, 185, 129, 0.2); color: #a7f3d0; padding: 0.2rem 0.5rem; border-radius: 4px;">Topic Scoping</span>
              </div>
              <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5;">
                Links the current Telegram Forum Topic or Discord Channel to a specific workspace project. Use <code>/unbind</code> to remove the link.
              </p>
            </div>

            <!-- /chat -->
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 1rem 1.25rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <code style="font-size: 1rem; color: #f43f5e; font-weight: 700;">/chat &lt;message&gt;</code>
                <span style="font-size: 0.75rem; background: rgba(244, 63, 94, 0.2); color: #fecdd3; padding: 0.2rem 0.5rem; border-radius: 4px;">LLM Router</span>
              </div>
              <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5;">
                Asks architecture, debugging, or general questions routed through LiteLLM (Claude 3.7 Sonnet / Gemini 3.7 Pro / DeepSeek-R1).
              </p>
            </div>

            <!-- /claude -->
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 1rem 1.25rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <code style="font-size: 1rem; color: #fbbf24; font-weight: 700;">/claude &lt;prompt&gt;</code>
                <span style="font-size: 0.75rem; background: rgba(251, 191, 36, 0.2); color: #fef3c7; padding: 0.2rem 0.5rem; border-radius: 4px;">Claude Code CLI</span>
              </div>
              <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5;">
                Dispatches Anthropic's official <code>claude</code> CLI in headless non-interactive mode inside the sandboxed workspace.
              </p>
            </div>

            <!-- Git Commands Group -->
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 1rem 1.25rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <code style="font-size: 1rem; color: #c084fc; font-weight: 700;">/clone • /pull • /push • /diff • /branch • /projects</code>
                <span style="font-size: 0.75rem; background: rgba(192, 132, 252, 0.2); color: #f3e8ff; padding: 0.2rem 0.5rem; border-radius: 4px;">Git Engine</span>
              </div>
              <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5;">
                Full git lifecycle control directly from chat with automated PAT and SSH key authentication.
              </p>
            </div>

            <!-- Obsidian Commands -->
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 1rem 1.25rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <code style="font-size: 1rem; color: #10b981; font-weight: 700;">/vault • /note &lt;Title&gt; | &lt;Content&gt;</code>
                <span style="font-size: 0.75rem; background: rgba(16, 185, 129, 0.2); color: #a7f3d0; padding: 0.2rem 0.5rem; border-radius: 4px;">Second Brain</span>
              </div>
              <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5;">
                Inspect your knowledge vault or append notes directly to Obsidian Inbox.
              </p>
            </div>
          </div>
        </section>

        <!-- ================================================================= -->
        <!-- 5. LITELLM GATEWAY                                                -->
        <!-- ================================================================= -->
        <section id="litellm-gateway" class="glass-card" style="padding: 2.25rem;">
