---
import Layout from '../layouts/Layout.astro';
---

<Layout title="OMV AI Orchestrator | Turn Your OMV Box Into a 24/7 Autonomous AI Agent">
  <!-- ========================================================================= -->
  <!-- HERO SECTION                                                              -->
  <!-- ========================================================================= -->
  <section style="padding: 5rem 0 3.5rem 0; text-align: center; position: relative;">
    <div class="container">
      <!-- Status Badge -->
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 9999px; padding: 0.4rem 1rem; margin-bottom: 2rem;">
        <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981; box-shadow: 0 0 10px #10b981;"></span>
        <span style="font-size: 0.85rem; font-weight: 600; color: #c7d2fe;">OMV 6 & 7 Native Plugin • Multi-Model Redundancy Ready</span>
      </div>

      <!-- Main Headline -->
      <h1 style="font-family: 'Outfit', sans-serif; font-size: clamp(2.5rem, 6vw, 4.25rem); font-weight: 900; line-height: 1.12; max-width: 960px; margin: 0 auto 1.5rem auto; letter-spacing: -0.03em;">
        Turn Your OMV Box Into a <span class="gradient-text">24/7 Autonomous AI Agent</span>
      </h1>

      <!-- Subtitle -->
      <p style="font-size: clamp(1.05rem, 2vw, 1.25rem); color: var(--text-muted); max-width: 800px; margin: 0 auto 2.5rem auto; line-height: 1.6;">
        Harness your existing <strong>Google AI Pro (Gemini 3.7)</strong>, <strong>Claude Pro (Claude 3.7 Sonnet)</strong>, and <strong>GitHub Copilot Pro</strong> subscriptions in an always-on, self-healing development stack. Control autonomous coding loops from <strong>Signal</strong>, <strong>Telegram</strong>, or <strong>Discord</strong>.
      </p>

      <!-- 1-Liner Quick-Start Box -->
      <div style="max-width: 720px; margin: 0 auto 2.5rem auto;">
        <div class="terminal-snippet">
          <div style="display: flex; align-items: center; gap: 0.75rem; overflow: hidden;">
            <span style="color: #6366f1; font-weight: 700;">$</span>
            <span class="terminal-text" id="heroInstallCmd">wget -qO- https://raw.githubusercontent.com/el-j/hs-ai-worker/main/scripts/install-plugin.sh | sudo bash</span>
          </div>
          <button class="copy-btn" id="heroCopyBtn" onclick="copyHeroCmd()">📋 Copy</button>
        </div>
      </div>

      <!-- Hero Call-to-Action Buttons -->
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="#configurator" class="btn btn-primary">⚡ Configure Your Subscriptions</a>
        <a href="#hardware" class="btn btn-secondary">📊 Tested Hardware Benchmarks</a>
        <a href="#plugin" class="btn btn-secondary">📦 Download .deb Plugin</a>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- KEY METRICS / HIGHLIGHT CARDS                                             -->
  <!-- ========================================================================= -->
  <section id="features" style="padding: 2rem 0 3.5rem 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem;">
        <div class="glass-card">
          <div style="font-size: 2rem; margin-bottom: 0.75rem;">🛡️</div>
          <h3 style="font-family: 'Outfit'; font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem;">Bulletproof Fallbacks</h3>
          <p style="color: var(--text-muted); font-size: 0.9rem;">
            When Anthropic hits 429 quota limits, requests seamlessly route to Vertex AI, Gemini 3.7 Pro, and GitHub Models without failing.
          </p>
        </div>

        <div class="glass-card">
          <div style="font-size: 2rem; margin-bottom: 0.75rem;">🔒</div>
          <h3 style="font-family: 'Outfit'; font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem;">0-SIM Signal & Telegram</h3>
          <p style="color: var(--text-muted); font-size: 0.9rem;">
            Control the server via End-to-End Encrypted Signal Linked Device mode (no phone number required for your server) or Telegram/Discord.
          </p>
        </div>

        <div class="glass-card">
          <div style="font-size: 2rem; margin-bottom: 0.75rem;">🐙</div>
          <h3 style="font-family: 'Outfit'; font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem;">Auto-Git Remote Push</h3>
          <p style="color: var(--text-muted); font-size: 0.9rem;">
            Agent tasks automatically cut isolated branches, execute test suites, apply clean diffs, and push directly to your GitHub/GitLab origin.
          </p>
        </div>

        <div class="glass-card">
          <div style="font-size: 2rem; margin-bottom: 0.75rem;">🧠</div>
          <h3 style="font-family: 'Outfit'; font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem;">Obsidian Knowledge Sync</h3>
          <p style="color: var(--text-muted); font-size: 0.9rem;">
            Real-time Syncthing sync feeds project specifications from your Obsidian vault directly into the agent's system prompt.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MULTI-MODEL REDUNDANCY ARCHITECTURE                                       -->
  <!-- ========================================================================= -->
  <section id="models" style="padding: 4.5rem 0;">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3.5rem;">
        <span class="badge badge-indigo">Multi-Model Redundancy</span>
        <h2 style="font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 800; margin-top: 0.75rem; letter-spacing: -0.02em;">
          One Unified Gateway for Your Subscriptions
        </h2>
        <p style="color: var(--text-muted); max-width: 650px; margin: 0.75rem auto 0 auto; font-size: 1.05rem;">
          Your agents communicate through LiteLLM virtual endpoints that automatically load-balance and failover between your accounts.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.75rem;">
        <!-- Virtual Alias: coder-smart -->
        <div class="glass-card" style="border-top: 4px solid #6366f1;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <span style="font-family: monospace; font-size: 1.1rem; font-weight: 700; color: #818cf8;">openai/coder-smart</span>
            <span class="badge badge-indigo">Primary Router</span>
          </div>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.25rem;">
            Architectural reasoning, complex code generation, and iterative self-healing.
          </p>
          <div style="background: rgba(0,0,0,0.3); border-radius: 0.5rem; padding: 0.85rem; font-size: 0.85rem; line-height: 1.7;">
            <div>1️⃣ <strong>Claude 3.7 Sonnet</strong> <span style="color: #6ee7b7;">(Direct Anthropic API)</span></div>
            <div>2️⃣ <strong>Claude 3.7 Sonnet</strong> <span style="color: #93c5fd;">(Google Cloud Vertex AI)</span></div>
            <div>3️⃣ <strong>Gemini 3.7 Pro</strong> <span style="color: #fcd34d;">(Google AI Studio)</span></div>
            <div>4️⃣ <strong>GitHub Models GPT-4o</strong> <span style="color: #c084fc;">(Copilot Pro Tokens)</span></div>
          </div>
        </div>

        <!-- Virtual Alias: coder-fast -->
        <div class="glass-card" style="border-top: 4px solid #10b981;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <span style="font-family: monospace; font-size: 1.1rem; font-weight: 700; color: #34d399;">openai/coder-fast</span>
            <span class="badge badge-green">Speed Tier</span>
          </div>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.25rem;">
            High-speed diff parsing, file tree summarization, and quick unit test analysis.
          </p>
          <div style="background: rgba(0,0,0,0.3); border-radius: 0.5rem; padding: 0.85rem; font-size: 0.85rem; line-height: 1.7;">
            <div>1️⃣ <strong>Gemini 3.7 Flash</strong> <span style="color: #34d399;">(Sub-200ms latency)</span></div>
            <div>2️⃣ <strong>Gemini 2.5 Flash</strong> <span style="color: #93c5fd;">(High throughput)</span></div>
            <div>3️⃣ <strong>Claude 3.5 Haiku</strong> <span style="color: #fcd34d;">(Fallback)</span></div>
          </div>
        </div>

        <!-- Virtual Alias: reasoning-heavy -->
        <div class="glass-card" style="border-top: 4px solid #8b5cf6;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <span style="font-family: monospace; font-size: 1.1rem; font-weight: 700; color: #a78bfa;">openai/reasoning-heavy</span>
            <span class="badge badge-purple">Deep Thinking</span>
          </div>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.25rem;">
            Exhaustive debugging of hard memory leaks, algorithmic design, and architectural refactoring.
          </p>
          <div style="background: rgba(0,0,0,0.3); border-radius: 0.5rem; padding: 0.85rem; font-size: 0.85rem; line-height: 1.7;">
            <div>1️⃣ <strong>o3-mini / o1</strong> <span style="color: #a78bfa;">(GitHub Models Pro)</span></div>
            <div>2️⃣ <strong>Claude 3.7 Sonnet Thinking</strong> <span style="color: #93c5fd;">(64k budget)</span></div>
            <div>3️⃣ <strong>Gemini 3.7 Pro Thinking</strong> <span style="color: #fcd34d;">(Fallback)</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- INTERACTIVE SUBSCRIPTION & .ENV CONFIGURATOR                             -->
  <!-- ========================================================================= -->
  <section id="configurator" style="padding: 4.5rem 0;">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3.5rem;">
        <span class="badge badge-indigo">Interactive Setup</span>
        <h2 style="font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 800; margin-top: 0.75rem; letter-spacing: -0.02em;">
          Configure Your Subscriptions
        </h2>
        <p style="color: var(--text-muted); max-width: 650px; margin: 0.75rem auto 0 auto; font-size: 1.05rem;">
          Select your active AI subscriptions and preferred messenger relay to instantly generate your ready-to-run <code>.env</code> file.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: start;">
        <!-- Left: Subscription Selectors -->
        <div class="glass-card">
          <h3 style="font-family: 'Outfit'; font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem;">1. Select Active Accounts</h3>

          <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
            <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer; padding: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 0.5rem;">
              <input type="checkbox" id="subGoogle" checked onchange="updateConfigPreview()" style="width: 18px; height: 18px; accent-color: #6366f1;">
              <div>
                <div style="font-weight: 600; font-size: 0.95rem;">Google AI Studio / Google AI Pro</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Gemini 3.7 Flash & Pro (API Key)</div>
              </div>
            </label>

            <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer; padding: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 0.5rem;">
              <input type="checkbox" id="subClaude" checked onchange="updateConfigPreview()" style="width: 18px; height: 18px; accent-color: #6366f1;">
              <div>
                <div style="font-weight: 600; font-size: 0.95rem;">Claude Pro / Anthropic Console</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Claude 3.7 Sonnet Thinking (API Key)</div>
              </div>
            </label>

            <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer; padding: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 0.5rem;">
              <input type="checkbox" id="subCopilot" checked onchange="updateConfigPreview()" style="width: 18px; height: 18px; accent-color: #6366f1;">
              <div>
                <div style="font-weight: 600; font-size: 0.95rem;">GitHub Copilot Pro (GitHub Models)</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">GPT-4o, o1, o3-mini tokens via Personal Access Token</div>
              </div>
            </label>
          </div>

          <h3 style="font-family: 'Outfit'; font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem;">2. Preferred Messenger Relay</h3>
          <div class="tabs" style="margin-bottom: 1rem;">
            <button class="tab-button active" id="btnRelayTelegram" onclick="selectRelay('telegram')">✈️ Telegram</button>
            <button class="tab-button" id="btnRelaySignal" onclick="selectRelay('signal')">🔒 Signal (E2EE)</button>
            <button class="tab-button" id="btnRelayDiscord" onclick="selectRelay('discord')">🎮 Discord</button>
          </div>
        </div>

        <!-- Right: Real-time Config Generator Output -->
        <div class="glass-card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h3 style="font-family: 'Outfit'; font-size: 1.25rem; font-weight: 700;">Generated .env Template</h3>
            <button class="copy-btn" id="configCopyBtn" onclick="copyConfigOutput()">📋 Copy .env</button>
          </div>
          <div class="terminal-block">
            <pre style="margin: 0; font-family: monospace; font-size: 0.82rem; line-height: 1.5; color: #a5b4fc; white-space: pre-wrap; word-break: break-all;" id="configPreview">Loading...</pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- TESTED HARDWARE & VERIFIED PERFORMANCE BENCHMARKS                        -->
  <!-- ========================================================================= -->
  <section id="hardware" style="padding: 4.5rem 0; background: rgba(0, 0, 0, 0.25);">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3.5rem;">
        <span class="badge badge-green">Tested & Verified</span>
        <h2 style="font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 800; margin-top: 0.75rem; letter-spacing: -0.02em;">
          Tested On Real Home Server Hardware
        </h2>
        <p style="color: var(--text-muted); max-width: 680px; margin: 0.75rem auto 0 auto; font-size: 1.05rem;">
          The AI Orchestrator stack offloads heavy LLM computing to cloud endpoints, resulting in near-zero CPU footprint and whisper-quiet operation on low-power home servers.
        </p>
      </div>

      <!-- Hardware Benchmark Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
        <!-- Benchmark Card 1: MicroServer -->
        <div class="glass-card" style="border-top: 4px solid #10b981;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
            <div>
              <h3 style="font-family: 'Outfit'; font-size: 1.2rem; font-weight: 700; color: #f8fafc;">MicroServers & SFF Boxes</h3>
              <div style="font-size: 0.8rem; color: #6ee7b7;">e.g., HP ProLiant Gen8 / Dell T30</div>
            </div>
            <span class="badge badge-green">Verified</span>
          </div>
          <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.88rem; background: rgba(0,0,0,0.3); padding: 1rem; border-radius: 0.5rem;">
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-muted);">CPU:</span>
              <strong>Intel Xeon E3-1265L / i3 (4C/8T)</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-muted);">RAM Usage:</span>
              <strong style="color: #34d399;">~340 MB total stack</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-muted);">Idle Power:</span>
              <strong style="color: #38bdf8;">~22W – 28W</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-muted);">Proxy Latency:</span>
              <strong style="color: #a78bfa;">11.2 ms</strong>
            </div>
          </div>
        </div>

        <!-- Benchmark Card 2: Low-Power Mini-PC -->
        <div class="glass-card" style="border-top: 4px solid #6366f1;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
            <div>
              <h3 style="font-family: 'Outfit'; font-size: 1.2rem; font-weight: 700; color: #f8fafc;">Mini-PCs & N100 DIY NAS</h3>
              <div style="font-size: 0.8rem; color: #818cf8;">Intel N100 / N305 / J4125</div>
            </div>
            <span class="badge badge-indigo">Ultra Low Power</span>
          </div>
          <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.88rem; background: rgba(0,0,0,0.3); padding: 1rem; border-radius: 0.5rem;">
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-muted);">CPU:</span>
              <strong>Intel Alder Lake-N (4 Cores)</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-muted);">RAM Usage:</span>
              <strong style="color: #34d399;">~310 MB total stack</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-muted);">Idle Power:</span>
              <strong style="color: #38bdf8;">~7W – 14W</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-muted);">Proxy Latency:</span>
              <strong style="color: #a78bfa;">8.4 ms</strong>
            </div>
          </div>
        </div>

        <!-- Benchmark Card 3: ARM64 SBC -->
        <div class="glass-card" style="border-top: 4px solid #f59e0b;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
            <div>
              <h3 style="font-family: 'Outfit'; font-size: 1.2rem; font-weight: 700; color: #f8fafc;">ARM64 Single-Board Computers</h3>
              <div style="font-size: 0.8rem; color: #fcd34d;">Raspberry Pi 5 / CM4 / Odroid</div>
            </div>
            <span class="badge badge-purple">Silent Node</span>
          </div>
          <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.88rem; background: rgba(0,0,0,0.3); padding: 1rem; border-radius: 0.5rem;">
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-muted);">CPU:</span>
              <strong>ARM Cortex-A76 (4 Cores)</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-muted);">RAM Usage:</span>
              <strong style="color: #34d399;">~280 MB total stack</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-muted);">Idle Power:</span>
              <strong style="color: #38bdf8;">~4W – 6W</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-muted);">Proxy Latency:</span>
              <strong style="color: #a78bfa;">14.1 ms</strong>
            </div>
          </div>
        </div>
      </div>

      <!-- Integrated OMV Plugin Telemetry Showcase -->
      <div class="glass-card" style="border: 1px solid rgba(99, 102, 241, 0.4); background: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(16, 185, 129, 0.04) 100%);">
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
          <span style="font-size: 2rem;">⚡</span>
          <div>
            <h3 style="font-family: 'Outfit'; font-size: 1.3rem; font-weight: 800;">Self-Monitoring Hardware Telemetry Engine</h3>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">
              The native OMV plugin continuously measures host CPU load averages, memory consumption, LiteLLM gateway ping times, and agent session activity directly within the OpenMediaVault WebGUI.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MESSENGER RELAYS & CHAT SIMULATOR                                         -->
  <!-- ========================================================================= -->
  <section id="messengers" style="padding: 4.5rem 0;">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3.5rem;">
        <span class="badge badge-indigo">Mobile & Remote Control</span>
        <h2 style="font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 800; margin-top: 0.75rem; letter-spacing: -0.02em;">
          Code From Anywhere via Chat
        </h2>
        <p style="color: var(--text-muted); max-width: 650px; margin: 0.75rem auto 0 auto; font-size: 1.05rem;">
          Dispatch coding jobs while on the train, review git diffs on mobile, and push clean PRs to your repositories.
        </p>
      </div>

      <div style="max-width: 780px; margin: 0 auto;">
        <!-- Chat Simulator Window -->
        <div class="chat-window">
          <div class="chat-header">
            <span style="font-size: 1.25rem;">🤖</span>
            <div>
              <div style="font-weight: 700; font-size: 0.95rem;">OMV Agent Relay • online</div>
              <div style="font-size: 0.75rem; color: #10b981;">OpenMediaVault 7 (Debian 12)</div>
            </div>
          </div>

          <div style="padding: 1.5rem; display: flex; flex-direction: column;">
            <!-- User prompt -->
            <div class="chat-bubble chat-user">
              /task my-repo "Add JWT auth middleware and run pytest suite"
            </div>

            <!-- Agent response -->
            <div class="chat-bubble chat-bot">
              🚀 <strong>Agent Task Launched (task_20260822_111500)</strong><br/>
              📁 Project: <code>my-repo</code><br/>
              🌿 Isolated Branch: <code>agent/task-20260822_111500</code><br/>
              🧠 Routing: <strong>Claude 3.7 Sonnet (Thinking)</strong><br/><br/>
              ⏳ Agent reading AST context, running test suite, self-healing...
            </div>

            <!-- Agent completion -->
            <div class="chat-bubble chat-bot" style="border-left: 3px solid #10b981;">
              ✅ <strong>Task Completed & Tests Passed!</strong><br/><br/>
              🚀 Branch pushed to origin: <code>agent/task-20260822_111500</code><br/>
              📊 <strong>Git Summary:</strong> 3 files modified, +84 / -12 lines<br/>
              📝 Execution log saved to <code>Obsidian/Projects/my-repo/agent-log.md</code>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- OPENMEDIAVAULT INSTALLATION GUIDE (3 WORKING METHODS)                      -->
  <!-- ========================================================================= -->
  <section id="plugin" style="padding: 4.5rem 0;">
    <div class="container">
      <div style="text-align: center; margin-bottom: 3.5rem;">
        <span class="badge badge-indigo">OMV 6 & 7 Native Setup</span>
        <h2 style="font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 800; margin-top: 0.75rem; letter-spacing: -0.02em;">
          Fast & Verified Installation Guide
        </h2>
        <p style="color: var(--text-muted); max-width: 680px; margin: 0.75rem auto 0 auto; font-size: 1.05rem;">
          Choose the installation workflow that matches your environment — via 1-liner SSH, OMV WebGUI Scheduled Tasks, or pure Docker Compose.
        </p>
      </div>

      <!-- Installation Method Tabs -->
      <div style="max-width: 860px; margin: 0 auto 2.5rem auto;">
        <div class="tabs" style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap;">
          <button class="tab-button active" id="btnInstallSSH" onclick="selectInstallMethod('ssh')">⚡ Method 1: SSH 1-Liner (Recommended)</button>
          <button class="tab-button" id="btnInstallGUI" onclick="selectInstallMethod('gui')">🖥️ Method 2: GUI-Only (Scheduled Task)</button>
          <button class="tab-button" id="btnInstallCompose" onclick="selectInstallMethod('compose')">🐳 Method 3: OMV-Extras Compose</button>
        </div>
      </div>

      <!-- Method 1: SSH Direct (Default Active) -->
      <div id="installMethodSSH" class="install-panel" style="display: block; max-width: 900px; margin: 0 auto;">
        <div class="glass-card" style="border-top: 4px solid #6366f1;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
            <h3 style="font-family: 'Outfit'; font-size: 1.35rem; font-weight: 800; color: #fff;">Method 1: Direct 1-Liner via SSH (Fastest)</h3>
            <span class="badge badge-indigo">Recommended</span>
          </div>
          <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;">
            Log into your OpenMediaVault server as <code>root</code> (or user with <code>sudo</code>) and run this single command. It clones the public repo from GitHub, builds the <code>.deb</code> package locally, and installs it via <code>apt</code> so all dependencies are resolved automatically.
          </p>

          <div class="terminal-snippet" style="margin-bottom: 1.5rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; overflow: hidden;">
              <span style="color: #6366f1; font-weight: 700;">$</span>
              <span class="terminal-text" id="cmdInstallSSH">wget -qO- https://raw.githubusercontent.com/el-j/hs-ai-worker/main/scripts/install-plugin.sh | sudo bash</span>
            </div>
            <button class="copy-btn" onclick="copySnippet('cmdInstallSSH', this)">📋 Copy</button>
          </div>

          <div style="background: rgba(99, 102, 241, 0.08); border-left: 3px solid #6366f1; padding: 1rem; border-radius: 0.25rem; font-size: 0.9rem; color: #c7d2fe;">
            <strong>Or manual 3-step clone & build:</strong><br/>
            <code>git clone https://github.com/el-j/hs-ai-worker.git /srv/dev-data/omv-stack</code><br/>
            <code>cd /srv/dev-data/omv-stack && bash build-deb.sh && sudo apt install -y ./openmediavault-ai-orchestrator_1.0.0_all.deb</code>
          </div>
        </div>
      </div>

      <!-- Method 2: GUI Scheduled Tasks (No SSH) -->
      <div id="installMethodGUI" class="install-panel" style="display: none; max-width: 900px; margin: 0 auto;">
        <div class="glass-card" style="border-top: 4px solid #10b981;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
            <h3 style="font-family: 'Outfit'; font-size: 1.35rem; font-weight: 800; color: #fff;">Method 2: GUI-Only Setup (Via OMV Scheduled Tasks)</h3>
            <span class="badge badge-green">Zero SSH Terminal Needed</span>
          </div>
          <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;">
            If you don't have SSH enabled, you can execute the installer as <code>root</code> directly from the OpenMediaVault WebGUI (uses <code>wget</code> which is pre-installed on all OMV/Debian systems):
          </p>

          <ol style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.8; margin-bottom: 1.5rem; padding-left: 1.5rem;">
            <li>In the OMV WebGUI, navigate to <strong>System ➔ Scheduled Tasks</strong> and click <strong>Create (+)</strong>.</li>
            <li>Set <strong>User</strong> to <code>root</code> and <strong>uncheck "Enable"</strong> (so it does not run repeatedly).</li>
            <li>In the <strong>Command</strong> box, paste the following command:</li>
          </ol>

          <div class="terminal-snippet" style="margin-bottom: 1.5rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; overflow: hidden;">
              <span style="color: #10b981; font-weight: 700;">$</span>
              <span class="terminal-text" id="cmdInstallGUI">wget -qO- https://raw.githubusercontent.com/el-j/hs-ai-worker/main/scripts/install-plugin.sh | bash</span>
            </div>
            <button class="copy-btn" onclick="copySnippet('cmdInstallGUI', this)">📋 Copy</button>
          </div>

          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6;">
            4. Click <strong>Save</strong>, highlight the newly created task in the list, and click <strong>Run (▶️)</strong>.<br/>
            5. Once complete, refresh your browser. <strong>Services ➔ AI Orchestrator</strong> will appear in your OMV sidebar!
          </p>
        </div>
      </div>

      <!-- Method 3: OMV-Extras Compose Plugin -->
      <div id="installMethodCompose" class="install-panel" style="display: none; max-width: 900px; margin: 0 auto;">
        <div class="glass-card" style="border-top: 4px solid #38bdf8;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
            <h3 style="font-family: 'Outfit'; font-size: 1.35rem; font-weight: 800; color: #fff;">Method 3: Pure OMV-Extras Compose (Docker-Only)</h3>
            <span class="badge badge-purple">No .deb Package Required</span>
          </div>
          <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;">
            If you already use the <strong>openmediavault-compose</strong> plugin from OMV-Extras, you can run the entire multi-model agent stack directly as a compose service:
          </p>

          <ol style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.8; margin-bottom: 1.5rem; padding-left: 1.5rem;">
            <li>Go to <strong>Services ➔ Compose ➔ Files</strong> and click <strong>Create (+)</strong>.</li>
            <li>Name it <code>ai-orchestrator</code> and paste the contents of our <a href="https://github.com/el-j/hs-ai-worker/blob/main/omv-compose-template.yaml" target="_blank" style="color: #38bdf8; text-decoration: underline;">omv-compose-template.yaml</a>.</li>
            <li>In the <strong>Environment</strong> tab, paste your generated <code>.env</code> from our <a href="#configurator" style="color: #818cf8; text-decoration: underline;">Configurator above</a>.</li>
            <li>Click <strong>Save</strong> and then <strong>Up (▶️)</strong> to bring all services online.</li>
          </ol>
        </div>
      </div>
    </div>
  </section>
</Layout>

<!-- Client-side Interactive Configurator & Tab Logic -->
<script is:inline>
  let selectedRelay = 'telegram';

  function selectInstallMethod(method) {
    document.querySelectorAll('.install-panel').forEach(p => p.style.display = 'none');
    document.querySelectorAll('#btnInstallSSH, #btnInstallGUI, #btnInstallCompose').forEach(b => b.classList.remove('active'));

    if (method === 'ssh') {
      document.getElementById('installMethodSSH').style.display = 'block';
      document.getElementById('btnInstallSSH').classList.add('active');
    } else if (method === 'gui') {
      document.getElementById('installMethodGUI').style.display = 'block';
      document.getElementById('btnInstallGUI').classList.add('active');
    } else if (method === 'compose') {
      document.getElementById('installMethodCompose').style.display = 'block';
      document.getElementById('btnInstallCompose').classList.add('active');
    }
  }

  function copySnippet(elementId, btnElement) {
    const text = document.getElementById(elementId).innerText;
    navigator.clipboard.writeText(text).then(() => {
      btnElement.innerText = '✅ Copied!';
      setTimeout(() => { btnElement.innerText = '📋 Copy'; }, 2000);
    });
  }

  function selectRelay(relay) {
    selectedRelay = relay;
    document.querySelectorAll('#btnRelayTelegram, #btnRelaySignal, #btnRelayDiscord').forEach(btn => btn.classList.remove('active'));
    if (relay === 'telegram') document.getElementById('btnRelayTelegram').classList.add('active');
    if (relay === 'signal') document.getElementById('btnRelaySignal').classList.add('active');
    if (relay === 'discord') document.getElementById('btnRelayDiscord').classList.add('active');
    updateConfigPreview();
  }

  function updateConfigPreview() {
    const subGoogle = document.getElementById('subGoogle')?.checked ?? true;
    const subClaude = document.getElementById('subClaude')?.checked ?? true;
    const subCopilot = document.getElementById('subCopilot')?.checked ?? true;

    let envText = `# ==============================================================================
# OpenMediaVault AI Orchestrator Stack (.env)
# ==============================================================================
DATA_DIR=/srv/dev-data
TZ=Europe/Berlin
LITELLM_MASTER_KEY=sk-omv-secret-master-key-change-me

# Git Committer Identity
GIT_AUTHOR_NAME=OMV AI Agent
GIT_AUTHOR_EMAIL=agent@omv-box.local
`;

    if (subGoogle) {
      envText += `\n# Google AI Pro -> https://aistudio.google.com/app/apikey\nGEMINI_API_KEY=your_gemini_api_key_here\n`;
    }
    if (subClaude) {
      envText += `\n# Claude Pro -> https://console.anthropic.com/\nANTHROPIC_API_KEY=your_anthropic_api_key_here\n`;
    }
    if (subCopilot) {
      envText += `\n# GitHub Copilot Pro -> https://github.com/settings/tokens\nGITHUB_TOKEN=your_github_personal_access_token\n`;
    }

    if (selectedRelay === 'telegram') {
      envText += `\n# Telegram Bot -> @BotFather\nTELEGRAM_BOT_TOKEN=your_telegram_bot_token\nTELEGRAM_ALLOWED_USER_ID=your_numeric_user_id\n`;
    } else if (selectedRelay === 'signal') {
      envText += `\n# Signal Messenger (E2EE Linked Device)\nSIGNAL_PHONE_NUMBER=+4915112345678\nSIGNAL_ALLOWED_PHONE_NUMBER=+4917098765432\n`;
    } else if (selectedRelay === 'discord') {
      envText += `\n# Discord Bot -> https://discord.com/developers/applications\nDISCORD_BOT_TOKEN=your_discord_bot_token\nDISCORD_ALLOWED_USER_ID=your_numeric_user_id\n`;
    }

    envText += `\n# Web Terminal Credentials (ttyd)\nTERMINAL_USER=admin\nTERMINAL_PASS=omvsecurepass`;

    const el = document.getElementById('configPreview');
    if (el) el.innerText = envText;
  }

  function copyHeroCmd() {
    const text = document.getElementById('heroInstallCmd').innerText;
    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById('heroCopyBtn');
      btn.innerText = '✅ Copied!';
      setTimeout(() => { btn.innerText = '📋 Copy'; }, 2000);
    });
  }

  function copyConfigOutput() {
    const text = document.getElementById('configPreview').innerText;
    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById('configCopyBtn');
      btn.innerText = '✅ Copied!';
      setTimeout(() => { btn.innerText = '📋 Copy .env'; }, 2000);
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateConfigPreview();
  });
</script>
