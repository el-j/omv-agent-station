---
import Layout from '../layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Agent Station — Autonomous Coding Agents for OpenMediaVault" description="A self-hosted OpenMediaVault plugin that runs autonomous coding agents on your own server, controlled from Signal, Telegram, or Discord.">
  <!-- ========================================================================= -->
  <!-- HERO SECTION                                                              -->
  <!-- ========================================================================= -->
  <section style="padding: 5rem 0 3.5rem 0; text-align: center; position: relative;">
    <div class="container">
      <!-- Status Badge -->
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 9999px; padding: 0.4rem 1rem; margin-bottom: 2rem;">
        <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981; box-shadow: 0 0 10px #10b981;"></span>
        <span style="font-size: 0.85rem; font-weight: 600; color: #c7d2fe;">Native OpenMediaVault 6 & 7 plugin</span>
      </div>

      <!-- Main Headline -->
      <h1 style="font-family: 'Outfit', sans-serif; font-size: clamp(2.25rem, 5.5vw, 3.75rem); font-weight: 900; line-height: 1.15; max-width: 900px; margin: 0 auto 1.5rem auto; letter-spacing: -0.03em;">
        Autonomous coding agents for <span class="gradient-text">your own server</span>
      </h1>

      <!-- Subtitle -->
      <p style="font-size: clamp(1.05rem, 2vw, 1.25rem); color: var(--text-muted); max-width: 760px; margin: 0 auto 2.5rem auto; line-height: 1.6;">
        Runs on your existing Google AI, Anthropic, or GitHub Copilot subscription. Dispatch coding tasks, review diffs, and merge pull requests from Signal, Telegram, or Discord — no laptop required.
      </p>

      <!-- 1-Liner Quick-Start Box -->
      <div style="max-width: 720px; margin: 0 auto 2.5rem auto;">
        <div class="terminal-snippet">
          <div style="display: flex; align-items: center; gap: 0.75rem; overflow: hidden;">
            <span style="color: #6366f1; font-weight: 700;">$</span>
            <span class="terminal-text" id="heroInstallCmd">wget -qO- https://raw.githubusercontent.com/el-j/omv-agent-station/main/scripts/install-plugin.sh | sudo bash</span>
          </div>
          <button class="copy-btn" id="heroCopyBtn" onclick="copyHeroCmd()">Copy</button>
        </div>
      </div>

      <!-- Hero Call-to-Action Buttons -->
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href={`${baseUrl}/docs/quickstart`} class="btn btn-primary">Get Started</a>
        <a href="https://github.com/el-j/omv-agent-station" target="_blank" class="btn btn-secondary">View on GitHub</a>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- KEY FEATURES                                                              -->
  <!-- ========================================================================= -->
  <section id="features" class="section" style="padding-top: 2rem;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem;">
        <div class="glass-card">
          <h3 style="font-family: 'Outfit'; font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem;">Automatic provider fallback</h3>
          <p style="color: var(--text-muted); font-size: 0.9rem;">
            When one provider hits a rate limit, requests route to the next configured model — Vertex AI, Gemini, or GitHub Models — with no manual intervention.
          </p>
        </div>

        <div class="glass-card">
          <h3 style="font-family: 'Outfit'; font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem;">Encrypted remote control</h3>
          <p style="color: var(--text-muted); font-size: 0.9rem;">
            Control the server over Signal (end-to-end encrypted, no phone number required for the server itself), Telegram, or Discord.
          </p>
        </div>

        <div class="glass-card">
          <h3 style="font-family: 'Outfit'; font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem;">Git-native task workflow</h3>
          <p style="color: var(--text-muted); font-size: 0.9rem;">
            Agent tasks run on an isolated branch, execute your test suite, and push the resulting diff to GitHub or GitLab.
          </p>
        </div>

        <div class="glass-card">
          <h3 style="font-family: 'Outfit'; font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem;">Obsidian sync</h3>
          <p style="color: var(--text-muted); font-size: 0.9rem;">
            Project specs sync from your Obsidian vault via Syncthing and feed directly into the agent's working context.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MULTI-MODEL ROUTING (brief -- full detail lives in the docs)             -->
  <!-- ========================================================================= -->
  <section id="models" class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">AI Gateway</span>
        <h2 class="section-title">One gateway across your subscriptions</h2>
        <p class="section-lead">
          A LiteLLM proxy sits between the agents and every configured provider, exposing three virtual models so you never hardcode a specific vendor.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
        <div class="glass-card" style="border-top: 3px solid #6366f1;">
          <span style="font-family: monospace; font-size: 1rem; font-weight: 700; color: #818cf8;">coder-smart</span>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.75rem;">Architectural reasoning, complex code generation, and iterative fixes.</p>
        </div>
        <div class="glass-card" style="border-top: 3px solid #10b981;">
          <span style="font-family: monospace; font-size: 1rem; font-weight: 700; color: #34d399;">coder-fast</span>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.75rem;">Diff parsing, file summarization, and quick test analysis.</p>
        </div>
        <div class="glass-card" style="border-top: 3px solid #8b5cf6;">
          <span style="font-family: monospace; font-size: 1rem; font-weight: 700; color: #a78bfa;">reasoning-heavy</span>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.75rem;">Hard debugging, algorithmic design, and architectural refactors.</p>
        </div>
      </div>

      <p style="text-align: center; color: var(--text-muted); font-size: 0.95rem;">
        Each router's provider order (Anthropic, Vertex AI, Gemini, GitHub Models, and optional free-tier OpenRouter models) is configurable —
        see the <a href={`${baseUrl}/docs/ai-models`} style="color: #818cf8;">full routing reference</a>.
      </p>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- INTERACTIVE SUBSCRIPTION & .ENV CONFIGURATOR                             -->
  <!-- ========================================================================= -->
  <section id="configurator" class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Setup</span>
        <h2 class="section-title">Generate your .env file</h2>
        <p class="section-lead">
          Select the subscriptions and messenger you plan to use to generate a ready-to-run <code>.env</code>.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: start;">
        <!-- Left: Subscription Selectors -->
        <div class="glass-card">
          <h3 style="font-family: 'Outfit'; font-size: 1.1rem; font-weight: 700; margin-bottom: 1.5rem;">Active accounts</h3>

          <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
            <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer; padding: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 0.5rem;">
              <input type="checkbox" id="subGoogle" checked onchange="updateConfigPreview()" style="width: 18px; height: 18px; accent-color: #6366f1;">
              <div>
                <div style="font-weight: 600; font-size: 0.95rem;">Google AI Studio</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Gemini, via API key</div>
              </div>
            </label>

            <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer; padding: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 0.5rem;">
              <input type="checkbox" id="subClaude" checked onchange="updateConfigPreview()" style="width: 18px; height: 18px; accent-color: #6366f1;">
              <div>
                <div style="font-weight: 600; font-size: 0.95rem;">Anthropic Console</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Claude, via API key</div>
              </div>
            </label>

            <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer; padding: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 0.5rem;">
              <input type="checkbox" id="subCopilot" checked onchange="updateConfigPreview()" style="width: 18px; height: 18px; accent-color: #6366f1;">
              <div>
                <div style="font-weight: 600; font-size: 0.95rem;">GitHub Copilot</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">GitHub Models, via personal access token</div>
              </div>
            </label>
          </div>

          <h3 style="font-family: 'Outfit'; font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem;">Messenger</h3>
          <div class="tabs" style="margin-bottom: 1rem;">
            <button class="tab-button active" id="btnRelayTelegram" onclick="selectRelay('telegram')">Telegram</button>
            <button class="tab-button" id="btnRelaySignal" onclick="selectRelay('signal')">Signal</button>
            <button class="tab-button" id="btnRelayDiscord" onclick="selectRelay('discord')">Discord</button>
          </div>
        </div>

        <!-- Right: Real-time Config Generator Output -->
        <div class="glass-card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h3 style="font-family: 'Outfit'; font-size: 1.1rem; font-weight: 700;">Generated .env</h3>
            <button class="copy-btn" id="configCopyBtn" onclick="copyConfigOutput()">Copy</button>
          </div>
          <div class="terminal-block">
            <pre style="margin: 0; font-family: monospace; font-size: 0.82rem; line-height: 1.5; color: #a5b4fc; white-space: pre-wrap; word-break: break-all;" id="configPreview">Loading...</pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- REQUIREMENTS                                                              -->
  <!-- ========================================================================= -->
  <section id="requirements" class="section" style="background: rgba(0, 0, 0, 0.25);">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Requirements</span>
        <h2 class="section-title">Runs on modest hardware</h2>
      </div>
      <p style="max-width: 700px; margin: 0 auto; text-align: center; color: var(--text-muted); font-size: 1.02rem; line-height: 1.7;">
        The language models run in the cloud through your existing subscriptions, so the local footprint is just container overhead —
        LiteLLM, Syncthing, a messenger relay, and a sandboxed workspace container. No GPU needed.
        The stack runs the same way on any Debian-based Linux, confirmed on both <code>amd64</code> and <code>arm64</code> (Raspberry Pi 4/5) —
        see the <a href={`${baseUrl}/docs/standalone-install`} style="color: #818cf8;">standalone install guide</a> for exact requirements.
      </p>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MESSENGER RELAYS & CHAT SIMULATOR                                         -->
  <!-- ========================================================================= -->
  <section id="messengers" class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Remote control</span>
        <h2 class="section-title">Dispatch a task from your phone</h2>
        <p class="section-lead">
          Send a prompt while on the train, review the diff, and the agent has already pushed a branch by the time you're home.
        </p>
      </div>

      <div style="max-width: 780px; margin: 0 auto;">
        <!-- Chat Simulator Window -->
        <div class="chat-window">
          <div class="chat-header">
            <span style="font-size: 1.1rem;">🤖</span>
            <div>
              <div style="font-weight: 700; font-size: 0.95rem;">Agent Station</div>
              <div style="font-size: 0.75rem; color: #10b981;">online</div>
            </div>
          </div>

          <div style="padding: 1.5rem; display: flex; flex-direction: column;">
            <!-- User prompt -->
            <div class="chat-bubble chat-user">
              /task my-repo "Add JWT auth middleware and run the pytest suite"
            </div>

            <!-- Agent response -->
            <div class="chat-bubble chat-bot">
              <strong>Task launched</strong> (task_20260822_111500)<br/>
              Project: <code>my-repo</code> · Branch: <code>agent/task-20260822_111500</code><br/>
              Model: <strong>coder-smart</strong><br/><br/>
              Reading project context, running the test suite...
            </div>

            <!-- Agent completion -->
            <div class="chat-bubble chat-bot" style="border-left: 3px solid #10b981;">
              ✅ <strong>Task completed, tests passed.</strong><br/><br/>
              Pushed to <code>agent/task-20260822_111500</code> — 3 files changed, +84 / -12 lines<br/>
              Log saved to <code>Obsidian/Projects/my-repo/agent-log.md</code>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- INSTALL                                                                   -->
  <!-- ========================================================================= -->
  <section id="install" class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Install</span>
        <h2 class="section-title">Get started</h2>
      </div>

      <div style="max-width: 780px; margin: 0 auto;">
        <div class="glass-card" style="border-top: 3px solid #6366f1;">
          <h3 style="font-family: 'Outfit'; font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem;">On an OpenMediaVault server</h3>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin-bottom: 1.25rem;">
            Log into your server via SSH (or the WebGUI's Scheduled Tasks, if you don't have SSH enabled) and run:
          </p>
          <div class="terminal-snippet" style="margin-bottom: 1rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; overflow: hidden;">
              <span style="color: #6366f1; font-weight: 700;">$</span>
              <span class="terminal-text" id="cmdInstallSSH">wget -qO- https://raw.githubusercontent.com/el-j/omv-agent-station/main/scripts/install-plugin.sh | sudo bash</span>
            </div>
            <button class="copy-btn" onclick="copySnippet('cmdInstallSSH', this)">Copy</button>
          </div>
          <p style="color: var(--text-muted); font-size: 0.88rem;">
            This builds and installs the <code>.deb</code> package, which adds <strong>Services → Agent Station</strong> to the OMV WebGUI.
          </p>
        </div>

        <p style="text-align: center; color: var(--text-muted); font-size: 0.92rem; margin-top: 1.5rem;">
          Not on OpenMediaVault, or prefer Docker Compose directly? See the
          <a href={`${baseUrl}/docs/quickstart`} style="color: #818cf8;">full install guide</a> or the
          <a href={`${baseUrl}/docs/standalone-install`} style="color: #818cf8;">standalone / Raspberry Pi guide</a>.
        </p>

        <!-- Uninstallation & Reset Callout -->
        <div style="max-width: 780px; margin: 2rem auto 0 auto;">
          <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 0.75rem; padding: 1.1rem 1.4rem; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;">
            <div style="text-align: left;">
              <div style="font-weight: 700; color: #f87171; font-size: 0.92rem; margin-bottom: 0.25rem;">Uninstall or reset</div>
              <div style="font-size: 0.85rem; color: var(--text-muted);">Removes the plugin and containers; workspace data in <code>/srv/dev-data</code> is preserved.</div>
            </div>
            <div class="terminal-snippet" style="margin: 0; min-width: 300px;">
              <div style="display: flex; align-items: center; gap: 0.5rem; overflow: hidden;">
                <span style="color: #ef4444; font-weight: 700;">$</span>
                <span class="terminal-text" id="cmdUninstall">wget -qO- https://raw.githubusercontent.com/el-j/omv-agent-station/main/scripts/uninstall-plugin.sh | sudo bash</span>
              </div>
              <button class="copy-btn" onclick="copySnippet('cmdUninstall', this)">Copy</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<!-- Client-side Interactive Configurator & Copy-to-Clipboard -->
<script is:inline>
  let selectedRelay = 'telegram';

  function copySnippet(elementId, btnElement) {
    const text = document.getElementById(elementId).innerText;
    navigator.clipboard.writeText(text).then(() => {
      btnElement.innerText = 'Copied';
      setTimeout(() => { btnElement.innerText = 'Copy'; }, 2000);
    });
  }

  function selectRelay(relay) {
    selectedRelay = relay;
    document.querySelectorAll('#btnRelayTelegram, #btnRelaySignal, #btnRelayDiscord').forEach(btn => btn.classList.remove('active'));
    if (relay === 'telegram') document.getElementById('btnRelayTelegram').classList.add('active');
    if (relay === 'signal') document.getElementById('btnRelaySignal').classList.add('active');
    if (relay === 'discord') document.getElementById('btnRelayDiscord').classList.add('active');
    updateConfigPreview();
  }

  function updateConfigPreview() {
    const subGoogle = document.getElementById('subGoogle')?.checked ?? true;
    const subClaude = document.getElementById('subClaude')?.checked ?? true;
    const subCopilot = document.getElementById('subCopilot')?.checked ?? true;

    let envText = `# ==============================================================================
# Agent Station Configuration (.env)
# ==============================================================================
DATA_DIR=/srv/dev-data
TZ=Europe/Berlin
LITELLM_MASTER_KEY=sk-omv-secret-master-key-change-me

# Git Committer Identity
GIT_AUTHOR_NAME=OMV AI Agent
GIT_AUTHOR_EMAIL=agent@omv-box.local
`;

    if (subGoogle) {
      envText += `\n# Google AI Studio -> https://aistudio.google.com/app/apikey\nGEMINI_API_KEY=your_gemini_api_key_here\n`;
    }
    if (subClaude) {
      envText += `\n# Anthropic Console -> https://console.anthropic.com/\nANTHROPIC_API_KEY=your_anthropic_api_key_here\n`;
    }
    if (subCopilot) {
      envText += `\n# GitHub Copilot -> https://github.com/settings/tokens\nGITHUB_TOKEN=your_github_personal_access_token\n`;
    }

    if (selectedRelay === 'telegram') {
      envText += `\n# Telegram Bot -> @BotFather\nTELEGRAM_BOT_TOKEN=your_telegram_bot_token\nTELEGRAM_ALLOWED_USER_ID=your_numeric_user_id\n`;
    } else if (selectedRelay === 'signal') {
      envText += `\n# Signal Messenger (E2EE Linked Device)\nSIGNAL_PHONE_NUMBER=+4915112345678\nSIGNAL_ALLOWED_PHONE_NUMBER=+4917098765432\n`;
    } else if (selectedRelay === 'discord') {
      envText += `\n# Discord Bot -> https://discord.com/developers/applications\nDISCORD_BOT_TOKEN=your_discord_bot_token\nDISCORD_ALLOWED_USER_ID=your_numeric_user_id\n`;
    }

    envText += `\n# Web Terminal Credentials (ttyd)\nTERMINAL_USER=admin\nTERMINAL_PASS=omvsecurepass`;

    const el = document.getElementById('configPreview');
    if (el) el.innerText = envText;
  }

  function copyHeroCmd() {
    const text = document.getElementById('heroInstallCmd').innerText;
    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById('heroCopyBtn');
      btn.innerText = 'Copied';
      setTimeout(() => { btn.innerText = 'Copy'; }, 2000);
    });
  }

  function copyConfigOutput() {
    const text = document.getElementById('configPreview').innerText;
    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById('configCopyBtn');
      btn.innerText = 'Copied';
      setTimeout(() => { btn.innerText = 'Copy'; }, 2000);
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateConfigPreview();
  });
</script>
