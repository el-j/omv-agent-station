#!/bin/sh
set -e

case "$1" in
    configure)
        # Ensure OMV local repository archives directory exists
        mkdir -p /var/cache/openmediavault/archives 2>/dev/null || true
        # Remove compiled datamodel cache files safely
        find /var/cache/openmediavault/ -maxdepth 1 -name "cache.*" -delete 2>/dev/null || true

        # Recompile OMV Workbench routing, navigation, and dashboard assets
        if command -v omv-mkworkbench >/dev/null 2>&1; then
            omv-mkworkbench all 2>/dev/null || true
        fi

        # Reload daemons in background so active RPC socket stream can finish cleanly
        if command -v systemctl >/dev/null 2>&1; then
            (
                sleep 1
                systemctl restart openmediavault-engined 2>/dev/null || true
                systemctl restart 'php*-fpm' 2>/dev/null || true
                systemctl reload nginx 2>/dev/null || true
            ) >/dev/null 2>&1 &
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
