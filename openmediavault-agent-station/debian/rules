#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_install:
	mkdir -p debian/openmediavault-agent-station/usr/share/openmediavault/engined/rpc
	mkdir -p debian/openmediavault-agent-station/usr/share/openmediavault/datamodels
	mkdir -p debian/openmediavault-agent-station/usr/share/openmediavault/workbench/component.d
	mkdir -p debian/openmediavault-agent-station/usr/share/openmediavault/workbench/navigation.d
	mkdir -p debian/openmediavault-agent-station/usr/share/openmediavault/workbench/route.d
	mkdir -p debian/openmediavault-agent-station/usr/share/openmediavault/workbench/dashboard.d
	mkdir -p debian/openmediavault-agent-station/usr/share/openmediavault/agent-station
	mkdir -p debian/openmediavault-agent-station/usr/sbin

	cp -r usr/share/openmediavault/engined/rpc/* debian/openmediavault-agent-station/usr/share/openmediavault/engined/rpc/ 2>/dev/null || true
	cp -r usr/share/openmediavault/datamodels/* debian/openmediavault-agent-station/usr/share/openmediavault/datamodels/ 2>/dev/null || true
	cp -r usr/share/openmediavault/workbench/component.d/* debian/openmediavault-agent-station/usr/share/openmediavault/workbench/component.d/ 2>/dev/null || true
	cp -r usr/share/openmediavault/workbench/navigation.d/* debian/openmediavault-agent-station/usr/share/openmediavault/workbench/navigation.d/ 2>/dev/null || true
	cp -r usr/share/openmediavault/workbench/route.d/* debian/openmediavault-agent-station/usr/share/openmediavault/workbench/route.d/ 2>/dev/null || true
	cp -r usr/share/openmediavault/workbench/dashboard.d/* debian/openmediavault-agent-station/usr/share/openmediavault/workbench/dashboard.d/ 2>/dev/null || true
	cp usr/sbin/omv-agent-station debian/openmediavault-agent-station/usr/sbin/
	chmod +x debian/openmediavault-agent-station/usr/sbin/omv-agent-station
	cp usr/sbin/omv-agent-station debian/openmediavault-agent-station/usr/sbin/ 2>/dev/null || true
	chmod +x debian/openmediavault-agent-station/usr/sbin/omv-agent-station 2>/dev/null || true

	cp -r ../docker-compose.yml ../litellm ../telegram-agent-bot ../signal-agent-bot ../discord-agent-bot debian/openmediavault-agent-station/usr/share/openmediavault/agent-station/
