#!/bin/sh
# postrm for openmediavault-agent-station
set -e

clean_workbench() {
    # Activate the update-workbench trigger (handled by OMV core, deferred until
    # dpkg finishes the whole transaction) so routes and widgets belonging to
    # this plugin are recompiled out of the WebGUI. This avoids both a
    # synchronous restart mid-RPC-session and clobbering the shared
    # /var/cache/openmediavault/cache.* files that belong to other plugins.
    dpkg-trigger update-workbench
}

case "$1" in
    purge)
        clean_workbench
        rm -f /etc/openmediavault-agent-station.json 2>/dev/null || true
        rm -f /etc/openmediavault-ai-orchestrator.json 2>/dev/null || true
        ;;

    remove|disappear)
        clean_workbench
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade)
        ;;

    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
