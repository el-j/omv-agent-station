#!/bin/sh
set -e

case "$1" in
    remove|purge|disappear)
        # Ensure archives directory exists and clear compiled cache
        mkdir -p /var/cache/openmediavault/archives 2>/dev/null || true
        find /var/cache/openmediavault/ -maxdepth 1 -name "cache.*" -delete 2>/dev/null || true

        # Recompile OMV Workbench after removing plugin assets
        if command -v omv-mkworkbench >/dev/null 2>&1; then
            omv-mkworkbench all 2>/dev/null || true
        fi

        # Refresh openmediavault-engined and PHP-FPM
        if command -v systemctl >/dev/null 2>&1; then
            (
                sleep 1
                systemctl restart openmediavault-engined 2>/dev/null || true
                systemctl restart 'php*-fpm' 2>/dev/null || true
                systemctl reload nginx 2>/dev/null || true
            ) >/dev/null 2>&1 &
        fi
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade)
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
